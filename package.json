{
  "name": "homebridge-ha-roborock-matter",
  "displayName": "HA Roborock Matter",
  "version": "0.3.0",
  "description": "Exposes a Roborock vacuum from Home Assistant to Apple Home as a native Matter robot vacuum (rooms, clean modes, errors, dock states).",
  "author": "Andrei Voinea",
  "license": "MIT",
  "homepage": "https://github.com/andreivcodes/homebridge-ha-roborock-matter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andreivcodes/homebridge-ha-roborock-matter.git"
  },
  "bugs": {
    "url": "https://github.com/andreivcodes/homebridge-ha-roborock-matter/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "config.schema.json"
  ],
  "engines": {
    "homebridge": "^2.4.0",
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "keywords": [
    "homebridge-plugin",
    "matter",
    "supports-matter",
    "roborock",
    "robot vacuum",
    "home assistant"
  ],
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "prepare": "npm run build",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run lint && npm test"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "eslint": "^9.39.5",
    "homebridge": "2.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1"
  }
}
